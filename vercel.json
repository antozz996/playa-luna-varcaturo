{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npx next build",
  "headers": [
    {
      "source": "/studio/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.sanity.io https://www.sanity.io"
        }
      ]
    }
  ]
}
